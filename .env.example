# ─── Database ────────────────────────────────────────────────────
# Full Postgres connection string. In production (Vercel + Neon/Supabase),
# this typically points to a connection-pooler (port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Required by Prisma 7 + @prisma/adapter-pg to bypass the pooler for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ─── Docker Compose (local dev only) ─────────────────────────────
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name

# ─── Auth ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_char_secret_here
BETTER_AUTH_URL=http://localhost:3000

# ─── Redis (Upstash REST client) ──────────────────────────────────
# Development (in .env.local): point to the local Docker upstash-proxy
#   UPSTASH_REDIS_REST_URL=http://localhost:8080
#   UPSTASH_REDIS_REST_TOKEN=local_dev
#
# Production: use your Upstash dashboard values.
UPSTASH_REDIS_REST_URL=https://YOUR_ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN
