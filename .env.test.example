# ─── Test Database ───────────────────────────────────────────────────
# Point this to a local test database or docker container.
DATABASE_URL=postgresql://test_user:test_password@localhost:5433/typeracer_test?schema=public

# Prisma 7 needs this because of prisma.config.ts
DIRECT_URL=postgresql://test_user:test_password@localhost:5433/typeracer_test?schema=public

# ─── Auth ─────────────────────────────────────────────────────────
# Test secrets
BETTER_AUTH_SECRET=your_test_secret_here
BETTER_AUTH_URL=http://localhost:3000

# ─── Redis (Upstash REST client) ──────────────────────────────────
# Test redis instance
UPSTASH_REDIS_REST_URL=http://localhost:8081
UPSTASH_REDIS_REST_TOKEN=local_dev
