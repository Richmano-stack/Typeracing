generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTH.JS (NextAuth) MODELS
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String?   @unique
  name          String?   // Display name for Auth.js
  emailVerified DateTime? // Email verification timestamp
  image         String?   // Profile image URL (from OAuth providers)
  hashedPassword String?  // For credentials authentication (null for OAuth-only users)
  lastLogin     DateTime? // Track last login time
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Game Stats
  racesPlayed   Int       @default(0)
  averageWpm    Float     @default(0)
  bestWpm       Int       @default(0)
  lastRaceAt    DateTime?

  // Relations
  races         Race[]
  accounts      Account[]
  sessions      Session[]
  
  @@index([email])
  @@index([username])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String  // "oauth" | "email" | "credentials"
  provider          String  // "github" | "google" | "credentials"
  providerAccountId String  // User ID from the provider
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String   // Email or user ID
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// APPLICATION MODELS
// ============================================

model Race {
  id        String   @id @default(uuid())
  wpm          Int
  accuracy     Float
  durationMs   Int
  charsTyped   Int
  charsCorrect Int
  mistakes     Int
  createdAt    DateTime @default(now())
  
  // Who played this race?
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([createdAt])
}